[Unit]
Description=WiFi Billing Spring Boot Backend (%I Slot)
After=network.target

[Service]
User=matthew
WorkingDirectory=/var/www/wifi-billing/slots/%I/Backend
EnvironmentFile=/var/www/wifi-billing/Backend/.env
EnvironmentFile=/var/www/wifi-billing/deployment/slots/%I.env
# Ensure web/API backend never runs background schedulers
ExecStart=/usr/bin/java -Djava.net.preferIPv4Stack=true -Dapp.scheduling.enabled=false -jar target/api-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
