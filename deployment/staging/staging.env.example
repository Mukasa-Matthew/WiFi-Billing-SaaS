# ==============================================================================
# Isolated Staging Environment Configuration (WiFi Billing SaaS)
# Port Layout: Backend :8090, Frontend :3090, Staging DB: radius_db_staging
# ==============================================================================

# 1. Database Isolation
# Dedicated database strictly separated from production radius_db.
# Role radius_user_staging has GRANT permissions ONLY on radius_db_staging.
SPRING_DATASOURCE_URL=jdbc:postgresql://100.88.129.17:5432/radius_db_staging
SPRING_DATASOURCE_USERNAME=radius_user_staging
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# 2. Server Binding & Internal Routing
SERVER_PORT=8090
SERVER_ADDRESS=127.0.0.1
PORT=3090
HOSTNAME=127.0.0.1
BACKEND_INTERNAL_URL=http://127.0.0.1:8090
PROVISIONING_PUBLIC_BASE_URL=https://staging.qticket.dev
APP_PUBLIC_BASE_URL=https://staging.qticket.dev

# 3. MarzPay Payment Isolation
# NOTE: MarzPay API does NOT have a public /sandbox endpoint.
# Leaving credentials blank automatically activates the built-in Mock Gateway
# in PaymentService. Furthermore, MARZPAY_API_BASE points to an isolated loopback
# port to enforce network-level egress blockage against real payment processing.
MARZPAY_PLATFORM_API_KEY=
MARZPAY_PLATFORM_API_SECRET=
MARZPAY_PLATFORM_WEBHOOK_SECRET=
MARZPAY_API_BASE=http://127.0.0.1:8099/api/v1

# 4. WireGuard & Router Provisioning Isolation
# Disables SSH command execution against the production WireGuard hub
# and prevents altering live customer routers.
WIREGUARD_PEER_MANAGEMENT_ENABLED=false
WIREGUARD_PEER_SYNC_ENABLED=false
ROUTER_MANAGEMENT_ENABLED=false

# 5. Customer Notification Isolation
# Leaving BREVO_API_KEY blank prevents live customer emails.
# OTP_DEV_FALLBACK=true prints verification codes to application logs instead of sending real SMS.
BREVO_API_KEY=
OTP_DEV_FALLBACK=true

# 6. Distributed Background Schedulers
# PostgreSQL advisory locking coordinates tasks safely across instances.
APP_SCHEDULING_ENABLED=true
