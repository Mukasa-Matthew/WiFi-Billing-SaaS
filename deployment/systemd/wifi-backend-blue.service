[Unit]
Description=WiFi Billing Spring Boot Backend (blue Slot)
After=network.target

[Service]
User=matthew
WorkingDirectory=/var/www/wifi-billing/slots/blue/Backend
EnvironmentFile=/var/www/wifi-billing/Backend/.env
EnvironmentFile=/var/www/wifi-billing/deployment/slots/blue.env
ExecStart=/usr/bin/java -Djava.net.preferIPv4Stack=true -Dserver.address=127.0.0.1 -Dserver.port=8080 -Dapp.scheduling.enabled=false -Dwireguard.peer-sync.enabled=false -Dapp.subscription.enforcement.enabled=false -Dspring.jpa.hibernate.ddl-auto=none -jar target/api-0.0.1-SNAPSHOT.jar
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
