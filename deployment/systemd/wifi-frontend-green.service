[Unit]
Description=WiFi Billing Next.js Frontend (Green Slot)
After=network.target

[Service]
User=matthew
WorkingDirectory=/var/www/wifi-billing/slots/green/Frontend
Environment=NODE_ENV=production
EnvironmentFile=/var/www/wifi-billing/deployment/slots/green.env
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
