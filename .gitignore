# ==============================================================================
# WiFi-Billing-SaaS Root .gitignore
# ==============================================================================

# Secrets & Environment Configurations (NEVER COMMIT CREDENTIALS)
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
*.pem
*.key
*.p12
*.jks
*db.env*

# Local PostgreSQL Development Data Directory
.pgdata/

# Backend (Java / Spring Boot / Maven)
Backend/target/
backend/target/
Backend/.mvn/wrapper/maven-wrapper.jar
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log
*.jar
*.war
hs_err_pid*
replay_pid*

# Frontend (Next.js / React)
Frontend/.next/
frontend/.next/
Frontend/out/
frontend/out/
Frontend/node_modules/
frontend/node_modules/
Frontend/.turbo/
frontend/.turbo/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Server-side artifacts (deploy backups, stale copies, npm strays)
backups/
Frontend/src.old-deploy/
Frontend/next
Frontend/frontend-app@*

# IDEs & System
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.DS_Store
Thumbs.db
