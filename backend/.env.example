# ==============================================================================
# WiFi Billing SaaS Backend — Environment Configuration Template
# Copy to .env (never commit real secrets) or export in your shell.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Primary Application Database (wifi_app)
# Default below connects to the isolated local PostgreSQL dev cluster (scripts/start_local_db.sh)
# For cloudserv SSH tunnel (scripts/start_cloudserv_tunnel.sh), use jdbc:postgresql://127.0.0.1:15432/wifi_app
DB_URL=jdbc:postgresql://127.0.0.1:5435/wifi_app_dev
DB_USER=wifi_app_user
DB_PASSWORD=local_dev_password_2026

# Infrastructure Provisioning Daemon URL (wifi-provisioning on cloudserv)
# Via SSH tunnel: http://127.0.0.1:18085 | On cloudserv directly: http://127.0.0.1:8085
PROVISIONING_BASE_URL=http://127.0.0.1:18085

# Allowed Frontend Origins for CORS (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
