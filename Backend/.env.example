# ==============================================================================
# WiFi-Billing SaaS - Backend Environment Configuration Template
# ==============================================================================

# Server
SERVER_PORT=8080

# PostgreSQL Database
SPRING_DATASOURCE_URL=jdbc:postgresql://100.88.129.17:5432/radius_db
SPRING_DATASOURCE_USERNAME=radius_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT Authentication (HS256 min 256-bit hex/base64 key)
JWT_SECRET=your_base64_or_hex_256bit_secret_key_here
JWT_EXPIRATION_HOURS=24

# WireGuard & RADIUS
WIREGUARD_SERVER_ENDPOINT=162.245.186.123:443
WIREGUARD_SERVER_PUBLIC_KEY=your_wireguard_server_public_key
WIREGUARD_SERVER_SUBNET=10.9.0.0/16
RADIUS_SERVER_IP=10.9.0.1
RADIUS_DEFAULT_SECRET=your_radius_secret

# Provisioning URL (Must be accessible by routers)
PROVISIONING_PUBLIC_BASE_URL=http://162.245.186.123:8080
PROVISIONING_SERVER_PUBLIC_IP=162.245.186.123

# WireGuard Hub Linux Peer Management
WIREGUARD_SERVER_INTERFACE=wg0
WIREGUARD_PEER_MANAGEMENT_ENABLED=false
WIREGUARD_PEER_MANAGEMENT_USE_SUDO=true
WIREGUARD_PEER_MANAGEMENT_WG_BINARY=/usr/bin/wg

# Telemetry
TELEMETRY_OFFLINE_AFTER_MINUTES=6

# Mobile Money Payments (mock or live)
PAYMENT_GATEWAY_MODE=mock
PAYMENT_GATEWAY_MOCK_AUTO_APPROVE_SECONDS=5
PAYMENT_WALLED_GARDEN_HOSTS=proxy.momoapi.mtn.com,openapi.airtel.africa,api.flutterwave.com
