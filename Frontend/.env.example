# ==============================================================================
# WiFi-Billing SaaS - Frontend Environment Configuration Template
# ==============================================================================

# Backend REST API base URL. Keep empty when the app is served same-origin
# (Next.js /api/[...path] route proxies to BACKEND_INTERNAL_URL).
NEXT_PUBLIC_API_URL=

# Public origin of this app — used for metadata/OG tags only. Set per
# environment; no code change needed when the domain changes
# (e.g. https://app.qticket.dev now, https://airpairy.com later).
NEXT_PUBLIC_APP_URL=

# Next.js Server Port
PORT=3000
